{
  "manifest_version": 2,
  "name": "live-fullscreen-wallpaper",
  "version": "1.0",
  "browser_specific_settings": {
    "gecko": {
      "id": "lfw@live-fullscreen-wallpaper",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "permissions": [
    "nativeMessaging"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "*://www.youtube.com/*",
        "*://music.youtube.com/*"
      ],
      "js": [
        "content.js"
      ]
    }
  ]
}
